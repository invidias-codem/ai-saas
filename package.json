{
  "name": "ai-saas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "dev": "next dev",
    "build:harness": "cd go-harness && GOOS=linux GOARCH=amd64 go build -o bin/lattice-harness ./cmd/lattice-harness || true",
    "build": "npm run build:harness && NODE_OPTIONS=--max-old-space-size=6144 next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:security": "./scripts/run-security-tests.sh",
    "test:security:unit": "jest __tests__/security/security-utils.test.ts",
    "test:security:integration": "jest __tests__/security/api-security.integration.test.ts",
    "test:security:e2e": "jest __tests__/security/security-e2e.test.ts",
    "test:rate-limits": "./scripts/test-rate-limits.sh",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=8192' tsc --noEmit --skipLibCheck --project tsconfig.build.json",
    "test:slack-stress": "./scripts/run-slack-stress-tests.sh",
    "setup:hooks": "./scripts/setup-git-hooks.sh",
    "deploy:check": "./scripts/pre-deployment-check.sh",
    "deploy:check:lite": "./scripts/pre-deployment-check-lite.sh",
    "curate:dataset": "tsx scripts/curate_dataset.ts",
    "eval:run": "tsx scripts/eval/run_eval.ts",
    "eval:compare": "tsx scripts/eval/compare_baseline.ts",
    "verify:import": "tsx scripts/verify_import_pipeline.ts",
    "rag:budget": "tsx scripts/check-rag-budget.ts",
    "rag:index": "tsx scripts/index-codebase.ts",
    "rag:index:dry": "tsx scripts/index-codebase.ts --dry-run",
    "rag:test": "tsx scripts/test-rag-integration.ts",
    "prebuild": "rm -rf functions/vector-agent-python/venv && echo prebuild: cleaned venv symlinks && pnpm --dir packages/lattice-core run build && pnpm --dir packages/lattice-mcp-local run build && pnpm --dir packages/lattice-mcp-remote run build && pnpm --dir packages/lattice-ai-skills run build",
    "dev:electron": "tsc -p electron/tsconfig.json && concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "build:electron:main": "tsc -p electron/tsconfig.json",
    "build:electron": "npm run build:electron:main && electron-builder",
    "mcp:local": "pnpm --filter @lattice-os/mcp-local start",
    "mcp:remote": "pnpm --filter @lattice-os/mcp-remote start",
    "ai-skills": "pnpm --filter @lattice-os/ai-skills start"
  },
  "build": {
    "appId": "xyz.gen1e.latticeos",
    "productName": "Lattice OS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist-electron/**/*",
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "go-harness/bin/lattice-harness-${os}-${arch}",
        "to": "bin/lattice-harness${ext}",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@anthropic-ai/sdk": "^0.74.0",
    "@atproto/api": "^0.13.15",
    "@clerk/clerk-js": "^5.62.0",
    "@clerk/nextjs": "^6.39.3",
    "@google-cloud/aiplatform": "^6.4.0",
    "@google-cloud/storage": "^7.17.2",
    "@google-cloud/tasks": "^6.2.1",
    "@google-cloud/vertexai": "^1.10.0",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^3.3.4",
    "@lattice-os/ai-skills": "workspace:*",
    "@lattice-os/core": "workspace:*",
    "@lattice-os/mcp-remote": "workspace:*",
    "@marsidev/react-turnstile": "^1.5.2",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.0.10",
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^1.8.0",
    "@octokit/app": "^16.1.2",
    "@paypal/react-paypal-js": "^9.0.1",
