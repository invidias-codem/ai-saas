  },
  "devDependencies": {
    "@jest/globals": "30.4.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@tauri-apps/cli": "^2.11.2",
    "@types/aws-lambda": "^8.10.161",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-syntax-highlighter": "^15.5.10",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@zapier/zapier-sdk-cli": "^0.70.0",
    "autoprefixer": "^10.4.24",
