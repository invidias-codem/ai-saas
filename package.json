    "read-excel-file": "^9.2.0",
    "reading-time": "^1.5.0",
    "recharts": "^3.3.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-unwrap-images": "^4.0.1",
    "replicate": "^1.4.0",
    "resend": "^6.9.2",
    "svix": "^1.87.0",
    "swr": "^2.4.1",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "unpdf": "^1.4.0",
