# ==============================================================================
# LATTICE QUICK START - MINIMUM REQUIRED VARS
# ==============================================================================
# 
# This file contains ONLY the required variables for a basic local run.
# For advanced features, integrations, and self-hosting options, 
# see .env.example or the docs.

DEPLOYMENT_MODE=A
PREFLIGHT_SECRET=your_secure_preflight_secret_here

# 1. Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# 2. Database & Storage (Supabase)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 3. AI Providers (At least one required)
GOOGLE_API_KEY=your_google_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key

# 4. RAG Memory Configuration
NEXT_PUBLIC_RAG_ENABLED=true
RAG_CLOUD_FUNCTION_URL=your_rag_cloud_function_url
