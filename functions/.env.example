# Firebase Cloud Functions Environment Variables

# Google Cloud
GOOGLE_CLOUD_PROJECT=genie-ai-1ca85
GOOGLE_CLOUD_REGION=us-central1

# Vertex AI
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL_TEXT_EMBEDDING=text-embedding-004
VERTEX_AI_MODEL_GEMINI=gemini-2.0-flash

# Firebase
FIREBASE_DATABASE_URL=https://genie-ai-1ca85.firebaseio.com

# Zapier Integration
ZAPIER_API_KEY=your_zapier_api_key_here
ZAPIER_WEBHOOK_SECRET=your_zapier_webhook_secret_here

# Slack Integration
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your-slack-signing-secret-here
SLACK_APP_ID=your-slack-app-id-here

# RAG Configuration
RAG_MEMORY_RETENTION_DAYS=90
RAG_RETRIEVAL_LIMIT=5
RAG_SIMILARITY_THRESHOLD=0.6
ENABLE_RAG_MEMORY=true

# External APIs
REPLICATE_API_TOKEN=your_replicate_token_here

# Security
FUNCTION_SECRET_KEY=your-secret-key-for-signing-requests
