{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lattice OS",
  "version": "0.1.0",
  "identifier": "xyz.gen1e.lattice-os",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "cross-env NEXT_PUBLIC_IS_DESKTOP=true pnpm dev",
    "beforeBuildCommand": "cross-env NEXT_PUBLIC_IS_DESKTOP=true pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Lattice OS",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/lattice-harness"
    ],
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "latticeos"
        ]
      }
    }
  }
}
