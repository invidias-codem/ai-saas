{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "stronghold:allow-initialize",
    "stronghold:allow-load-client",
    "stronghold:allow-create-client",
    "stronghold:allow-save",
    "stronghold:allow-insert",
    "stronghold:allow-get",
    "stronghold:allow-remove",
    "window:allow-get-current-window",
    "window:default"
  ]
}
