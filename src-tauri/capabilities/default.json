{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local main webview lifecycle and native-confirmed read-only workspace access",
  "webviews": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "native-host-control",
    "native-workspace-read",
    "native-proposal-control",
    "native-review-decision",
    "native-operation-control"
  ]
}
