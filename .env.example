# ==============================================================================
# MODE A - REQUIRED BASELINE
# These variables are strictly required when DEPLOYMENT_MODE=A
# ==============================================================================
DEPLOYMENT_MODE=A

# Preflight Secret (Required for Mode A health checks)
PREFLIGHT_SECRET=your_secure_preflight_secret_here

# 1. Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# 2. Database & Storage (Supabase)
# Must point to a managed Supabase project or an official Supabase Local Stack
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 3. AI Providers (At least one required for standard reasoning)
GOOGLE_API_KEY=your_google_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key
# DEEPSEEK_API_KEY=your_deepseek_api_key

# 4. RAG Memory Configuration
NEXT_PUBLIC_RAG_ENABLED=true
RAG_CLOUD_FUNCTION_URL=your_rag_cloud_function_url

# ==============================================================================
# OPTIONAL / ADVANCED MODES (Mode B, C, D)
# ==============================================================================

# Slack Integration
# SLACK_APP_ID=
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# SLACK_CLIENT_SECRET=

# Zapier Integration
# ZAPIER_CLIENT_ID=
# ZAPIER_CLIENT_SECRET=
# ZAPIER_API_KEY=
# ZAPIER_WEBHOOK_SECRET=

# Advanced Media / Video Generation
# REPLICATE_API_TOKEN=
# REPLICATE_API_TOKEN_MUSIC=
# REPLICATE_API_TOKEN_VIDEO=

# Google Cloud / Vertex AI (Advanced)
# GOOGLE_PROJECT_ID=
# GOOGLE_LOCATION=us-central1
# GCP_SERVICE_ACCOUNT_KEY_JSON=
