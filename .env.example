# ==============================================================================
# MODE A - REQUIRED BASELINE
# These variables are strictly required when DEPLOYMENT_MODE=A
# ==============================================================================
DEPLOYMENT_MODE=A

# Preflight Secret (Required for Mode A health checks)
PREFLIGHT_SECRET=your_secure_preflight_secret_here

# 1. Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# 2. Database & Storage (Supabase)
# Must point to a managed Supabase project or an official Supabase Local Stack
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 3. AI Providers (At least one required for standard reasoning)
GOOGLE_API_KEY=your_google_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key
# DEEPSEEK_API_KEY=your_deepseek_api_key

# 4. RAG Memory Configuration
NEXT_PUBLIC_RAG_ENABLED=true
RAG_CLOUD_FUNCTION_URL=your_rag_cloud_function_url

# 5. Ko-fi Donation Nudge
NEXT_PUBLIC_KOFI_PAGE=joshuajair

# Ko-fi alternative payment rail (optional; Stripe remains canonical).
# KOFI_WEBHOOK_SECRET: bearer token Ko-fi sends as `verification_token` in
#   every webhook. Set the same value in https://ko-fi.com/manage/webhooks.
# KOFI_JWT_SECRET: HMAC secret for short-lived checkout JWTs that travel via
#   the buyer's Ko-fi "message" field. 15-minute expiry. Generate with:
#     openssl rand -base64 32
KOFI_WEBHOOK_SECRET=
KOFI_JWT_SECRET=

# 6. Master User Bypass (comma-separated, grants unlimited access)
MASTER_USER_EMAILS=

# ==============================================================================
# OPTIONAL / ADVANCED MODES (Mode B, C, D)
# ==============================================================================

# Slack Integration
# SLACK_APP_ID=
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# SLACK_CLIENT_SECRET=

# Zapier Integration
# ZAPIER_CLIENT_ID=
# ZAPIER_CLIENT_SECRET=
# ZAPIER_API_KEY=
# ZAPIER_WEBHOOK_SECRET=

# Advanced Media / Video Generation
# REPLICATE_API_TOKEN=
# REPLICATE_API_TOKEN_MUSIC=
# REPLICATE_API_TOKEN_VIDEO=

# Google Cloud / Vertex AI (Advanced)
# GOOGLE_PROJECT_ID=
# GOOGLE_LOCATION=us-central1
# GCP_SERVICE_ACCOUNT_KEY_JSON=

# ==============================================================================
# Sovereign AI Telemetry (UDIF 2.0 audit ledger)
# ==============================================================================

# Dedicated, ISOLATED Supabase instance for high-volume audit writes (Phase 3).
# Keep separate from the main transactional DB (auth/payments) per Q3 decision.
# SUPABASE_TELEMETRY_URL=https://<your-telemetry-project>.supabase.co
# SUPABASE_TELEMETRY_SERVICE_ROLE=<service-role-key>

# Server-held Ed25519 private key (hex, 32 bytes) for asymmetric record signing
# (Phase 3.2-b). When set, the /api/telemetry/flush endpoint signs each link
# with real Ed25519; the published public key lets any auditor verify. Leave
# unset to use the keyless hash-chain fallback (still tamper-evident).
# TELEMETRY_SIGNING_KEY=<64-hex-char-ed25519-private-key>

# Optional client-side signing key (browser/Tauri). When set, the native client
# pre-signs records with its own Ed25519 key before flushing.
# NEXT_PUBLIC_TELEMETRY_SIGNING_KEY=<64-hex-char-ed25519-private-key>
