{
  "crons": [
    {
      "path": "/api/cron/slack-indexer",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/blog-weekly",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/bluesky-feed-poll",
      "schedule": "*/3 * * * *"
    }
  ],
  "functions": {
    "app/api/cron/slack-indexer/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/blog-weekly/route.ts": {
      "maxDuration": 300
    }
  }
}
