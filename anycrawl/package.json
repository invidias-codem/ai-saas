{
    "name": "anycrawl",
    "private": true,
    "scripts": {
        "dev": "turbo run dev --parallel --filter=!docs",
        "dev:api": "turbo run dev --filter=api",
        "dev:docs": "turbo run dev --filter=docs",
        "dev:scrape": "turbo run dev --filter=@anycrawl/scrape",
        "build": "turbo run build",
        "build:api": "turbo run build --filter=api",
        "build:docs": "turbo run build --filter=docs",
        "build:no-docs": "turbo run build --filter=!docs",
        "start": "turbo run start",
        "start:api": "turbo run start --filter=api",
        "start:docs": "turbo run start --filter=docs",
        "test": "turbo run test",
        "test:watch": "turbo run test:watch",
        "test:coverage": "turbo run test:coverage",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
        "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
        "typecheck": "turbo run typecheck",
        "clean": "turbo run clean && rm -rf node_modules",
        "clean:deps": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
        "clean:dist": "find . -name 'dist' -type d -prune -exec rm -rf '{}' +",
        "install:playwright": "cd packages/scrape && pnpm playwright install --with-deps",
        "install:puppeteer": "cd packages/scrape && pnpm puppeteer browsers install chrome",
        "db:generate": "turbo run db:generate --filter=@anycrawl/db",
        "db:migrate": "turbo run db:migrate --filter=@anycrawl/db",
        "check:deps": "dotenv-run -- knip",
        "check:phantom-deps": "dotenv-run -- knip --include=unlisted",
        "create:test:template": "cd packages/template-client && pnpm create:test:template",
        "templates:generate": "tsx templates/generate-sql.ts",
        "templates:apply": "dotenv-run -- tsx templates/apply-all-sql.ts"
    },
    "devDependencies": {
        "@anycrawl/js-sdk": "workspace:*",
        "@dotenv-run/cli": "^1.3.6",
        "knip": "^5.47.0",
        "prettier": "^3.5.3",
        "tsx": "^4.19.4",
        "turbo": "^2.4.4",
        "typescript": "5.8.2"
    },
    "packageManager": "pnpm@10.12.4",
    "engines": {
        "node": ">=18"
    },
    "pnpm": {
        "overrides": {
            "fast-xml-parser": ">=5.5.6",
            "tar": ">=7.5.11",
            "glob": "^9.0.0 || ^10.0.0 || >=11.1.0",
            "@isaacs/brace-expansion": ">=5.0.1",
            "lodash": ">=4.17.23",
            "mdast-util-to-hast": ">=13.2.1",
            "undici": ">=7.24.0",
            "body-parser": ">=2.2.1",
            "js-yaml": ">=4.1.1",
            "esbuild": ">=0.25.0",
            "qs": "^6.14.2",
            "@smithy/config-resolver": "^4.4.0",
            "basic-ftp": ">=5.3.0",
            "handlebars": "^4.7.9",
            "minimatch": ">=10.2.1",
            "path-to-regexp": ">=8.4.0",
            "brace-expansion": ">=4.0.0",
            "follow-redirects": ">=1.15.6",
            "flatted": ">=3.4.2",
            "picomatch": ">=4.0.4",
            "drizzle-orm": ">=0.45.2",
            "next": ">=15.5.15"
        }
    },
    "dependencies": {
        "axios": "^1.13.5"
    }
}