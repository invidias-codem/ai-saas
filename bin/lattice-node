#!/usr/bin/env node

const readline = require('readline');
const fs = require('fs');
const os = require('os');
const path = require('path');
const { spawn } = require('child_process');

const API_URL = process.env.LATTICE_API_URL || 'http://localhost:3000';
const USER_ID = process.env.LATTICE_USER_ID || '';
let TOKEN = process.env.LATTICE_TOKEN || '';
const tokenPath = path.join(os.homedir(), '.lattice', 'token');
try {
  TOKEN = fs.readFileSync(tokenPath, 'utf8').trim() || TOKEN;
} catch {}

if (!USER_ID) {
  console.error('LATTICE_USER_ID is required');
  process.exit(1);
}

const LATTICE_HOME = path.join(os.homedir(), '.lattice');
const SETTINGS_PATH = path.join(LATTICE_HOME, 'settings');

let settings = { approval_mode: 'prompt', approved_commands: 'ls,cat,pwd,whoami,date,echo,git status,git diff' };
let approvedCommands = settings.approved_commands.split(',').map(s => s.trim()).filter(Boolean);

function readSettings() {
  try {
    if (!fs.existsSync(SETTINGS_PATH)) return settings;
    const raw = fs.readFileSync(SETTINGS_PATH, 'utf8');
    const next = { ...settings };
    for (const line of raw.split(/\n+/)) {
      const trimmed = line.trim();
      if (!trimmed || trimmed.startsWith('#')) continue;
      const eq = trimmed.indexOf('=');
      if (eq <= 0) continue;
      const k = trimmed.slice(0, eq).trim();
      const v = trimmed.slice(eq + 1).trim();
      if (k) next[k] = v;
    }
    settings = next;
    approvedCommands = String(settings.approved_commands || '').split(',').map(s => s.trim()).filter(Boolean);
    return settings;
  } catch {
    return settings;
  }
}

function buildHeaders() {
  const headers = {
    'Content-Type': 'application/json',
    'x-lattice-user-id': USER_ID,
  };
  if (TOKEN) {
    headers['Authorization'] = `Bearer ${TOKEN}`;
  }
  return headers;
}

function isRemoteURL(str) {
  if (!str || typeof str !== 'string') return false;
  const trimmed = str.trim();
  return /^(https?:)?\/\//i.test(trimmed) || /^[a-z][a-z0-9+.-]*:\/\//i.test(trimmed);
}

function isApprovedCommand(cmd) {
  if (!cmd || typeof cmd !== 'string') return false;
  const trimmed = cmd.trim();
  const first = trimmed.split(/\s+/)[0];
  return approvedCommands.some(approved => trimmed === approved || first === approved);
}

function approvalDecision(cmd) {
  if (!cmd || typeof cmd !== 'string') return 'deny';
  if (isRemoteURL(cmd)) return 'deny';
  if (isApprovedCommand(cmd)) return 'auto';
  const mode = String(settings.approval_mode || 'prompt').trim().toLowerCase();
  if (mode === 'auto') return 'auto';
  if (mode === 'deny') return 'deny';
  return 'prompt';
}

function runLocalBash(cmd, cwd = process.cwd()) {
  return new Promise((resolve) => {
    const child = spawn('bash', ['-lc', cmd], { cwd, env: process.env });
    let stdout = '';
    let stderr = '';
    child.stdout.on('data', d => { stdout += d.toString(); });
    child.stderr.on('data', d => { stderr += d.toString(); });
    child.on('error', err => resolve({ command: cmd, status: 'error', stdout: '', stderr: String(err?.message || err) }));
    child.on('close', code => resolve({ command: cmd, status: `exit:${String(code)}`, stdout, stderr }));
  });
}

function buildLocalResponse(command, result) {
  return {
    command,
    mode: 'local',
    status: result.status,
    stdout: result.stdout,
    stderr: result.stderr,
  };
}

function buildLocalRejected(command, reason) {
  return {
    command,
    mode: 'local',
    status: 'rejected',
    stdout: '',
    stderr: reason,
  };
}

async function promptUserForAuth(cmd) {
  if (!process.stdin.isTTY || !process.stdout.isTTY) return false;
  const rl = readline.createInterface({ input: process.stdin, output: process.stdout, terminal: true });
  try {
    return await new Promise((resolve) => {
      rl.question(`[lattice-guard] Approve command? [y/N] ${cmd}\n> `, (answer) => {
        resolve(/^[Yy]$/.test(String(answer || '').trim()));
      });
    });
  } finally {
    rl.close();
  }
}

async function main() {
  readSettings();
  const rl = readline.createInterface({
    input: process.stdin,
    output: process.stdout,
    terminal: true,
  });

  const args = process.argv.slice(2);
  const localFlagIndex = args.indexOf('--local');
  const localMode = localFlagIndex !== -1;
  const promptIndex = args.indexOf('prompt');
  const explicitPrompt = promptIndex !== -1 ? args.slice(promptIndex + 1).join(' ') : '';

  const question = () =>
    new Promise((resolve) => {
      rl.question('❯ ', resolve);
    });

  while (true) {
    const prompt = explicitPrompt || await question();
    const trimmed = prompt.trim();
    if (!trimmed) continue;
    if (trimmed === 'exit' || trimmed === 'quit') break;

    process.stdout.write('\n');
    await streamPrompt(trimmed, { localMode });
    process.stdout.write('\n\n');
  }

  rl.close();
}

async function streamPrompt(prompt, opts = {}) {
  const body = JSON.stringify({
    messages: [
      { role: 'user', text: prompt },
    ],
    options: {
      localMode: !!opts.localMode,
    },
  });

  const res = await fetch(`${API_URL}/api/cli/stream`, {
    method: 'POST',
    headers: buildHeaders(),
    body,
  });

  if (!res.ok) {
    const text = await res.text();
    process.stdout.write(`Error: ${res.status} ${text}\n`);
    return;
  }

  if (!res.body) {
    process.stdout.write('No response stream\n');
    return;
  }

  const reader = res.body.getReader();
  const decoder = new TextDecoder();
  let buffer = '';

  while (true) {
    const { done, value } = await reader.read();
    if (done) break;

    buffer += decoder.decode(value, { stream: true });
    const lines = buffer.split('\n');
    buffer = lines.pop() ?? '';

    for (const line of lines) {
      const trimmed = line.trim();
      if (!trimmed || trimmed.startsWith('event:')) continue;
      if (trimmed.startsWith('data:')) {
        const raw = trimmed.slice(5).trim();
        if (raw.startsWith('{')) {
          try {
            const parsed = JSON.parse(raw);
            if (parsed.execution?.local) {
              const cmd = parsed.execution.command;
              const decision = approvalDecision(cmd);
              if (decision === 'deny' || (decision === 'prompt' && !(await promptUserForAuth(cmd)))) {
                const rejected = buildLocalRejected(cmd, 'Command blocked by local approval matrix');
                console.log(JSON.stringify({ event: 'local_result', data: JSON.stringify(rejected) }));
                continue;
              }
              const result = await runLocalBash(cmd, parsed.execution.cwd);
              const localResponse = buildLocalResponse(cmd, result);
              console.log(JSON.stringify({ event: 'local_result', data: JSON.stringify(localResponse) }));
              continue;
            }
            if (parsed.done) continue;
            if (parsed.error) {
              process.stdout.write(`\n[error] ${parsed.error}\n`);
              continue;
            }
          } catch {
            // fall through and write raw
          }
        }
        process.stdout.write(raw);
      }
    }
  }
}

main().catch((error) => {
  console.error(error);
  process.exit(1);
});
