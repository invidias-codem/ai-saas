# pnpm config for Vercel (pnpm@10.x) + Turbopack compatibility
# Hoist problematic ESM/CommonJS hybrid packages that Turbopack can't resolve
shamefully-hoist=true

# Specific package hoisting patterns for preview generator dependencies
hoist-pattern[]=mammoth
hoist-pattern[]=pdf-parse
hoist-pattern[]=pdfjs-dist
hoist-pattern[]=xlsx
hoist-pattern[]=file-type

# Ensure node-linker uses isolated for better TurboPack compatibility
node-linker=isolated

# Allow native builds for packages that need it
allow-builds=sharp,bufferutil,utf-8-validate,core-js,esbuild,unrs-resolver

# Disable strict peer dependency checks for optional peers
strict-peer-dependencies=false

# Use store for faster installs
store-dir=~/.pnpm-store